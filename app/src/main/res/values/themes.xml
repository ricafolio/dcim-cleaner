<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DCIMCleaner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FF9E77ED</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Keep buttons deep violet -->
        <item name="materialButtonStyle">@style/Widget.DCIMCleaner.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.DCIMCleaner.Button.Outlined</item>

        <!-- Fonts -->
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
    </style>

    <style name="Widget.DCIMCleaner.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_500</item>
    </style>

    <style name="Widget.DCIMCleaner.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_500</item>
        <item name="android:textColor">@color/purple_500</item>
    </style>

    <style name="Theme.DCIMCleaner.Fullscreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>