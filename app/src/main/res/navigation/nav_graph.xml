<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment android:id="@+id/nav_home"
        android:name="com.dcimcleaner.ui.home.HomeFragment"
        android:label="Home" />

    <fragment android:id="@+id/nav_images"
        android:name="com.dcimcleaner.ui.images.ImagesFragment"
        android:label="Image Cleaner">
        <argument android:name="load_month" android:defaultValue="@null" app:argType="string" app:nullable="true" />
        <argument android:name="load_day" android:defaultValue="@null" app:argType="string" app:nullable="true" />
        <argument android:name="pick_random" android:defaultValue="@null" app:argType="string" app:nullable="true" />
    </fragment>

    <fragment android:id="@+id/nav_analyzer"
        android:name="com.dcimcleaner.ui.analyzer.AnalyzerFragment"
        android:label="DCIM Analyzer" />

    <fragment android:id="@+id/nav_trash"
        android:name="com.dcimcleaner.ui.trash.TrashFragment"
        android:label="Your Trash" />

    <fragment android:id="@+id/nav_settings"
        android:name="com.dcimcleaner.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment android:id="@+id/nav_help"
        android:name="com.dcimcleaner.ui.help.HelpFragment"
        android:label="Help &amp; About" />

</navigation>
