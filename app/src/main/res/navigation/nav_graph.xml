<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_images">

    <fragment
        android:id="@+id/nav_images"
        android:name="com.dcimcleaner.ui.images.ImagesFragment"
        android:label="Image cleaner">
        <argument android:name="load_month" android:defaultValue="@null"
            app:argType="string" app:nullable="true" />
        <argument android:name="load_day" android:defaultValue="@null"
            app:argType="string" app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_analyzer"
        android:name="com.dcimcleaner.ui.analyzer.AnalyzerFragment"
        android:label="DCIM Analyzer" />

</navigation>
