<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App icon + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="App Logo"
                app:srcCompat="@drawable/icon_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DCIM Cleaner"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- About -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABOUT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="Scrolling through thousands of photos is exhausting. DCIM Cleaner helps you reclaim your storage by scanning your camera roll by date. Pick a random month or day, see what's there, and decide what to keep—making the cleanup process a surprise rather than a chore." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- How to use -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOW TO USE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📊  DCIM Analyzer" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Break down photos by Year, Month, or Day. View file counts and total size per period. Tap any row to open that batch in the grid, or tap headers to sort data."
                    android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="14dp" android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎲  Random Picker" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Feeling overwhelmed? Let the app choose for you. Load a random batch of photos from a surprise date to start cleaning instantly."
                    android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="14dp" android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚡  Quick Trash &amp; Navigation" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Enable Quick Trash to delete with one tap, or long-press in the grid. In full-screen, tap the left/right corners to navigate faster than swiping. Swipe down to dismiss."
                    android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="14dp" android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🖼  Grid Features" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Switch between 3 or 5 column layouts. Each thumbnail displays its file size so you know exactly how much space you are saving."
                    android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="14dp" android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⬛  Smart Widgets" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Add 'Clean Me Up' (2x1) for a random date suggestion every 6 hours, or 'Storage Tracker' (4x1) to monitor space gains and losses compared to yesterday."
                    android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="14dp" android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚙️  Settings" android:textStyle="bold" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Exclude subfolders like Screenshots from your index. Use Re-index to refresh the app after taking new photos or changing folder settings."
                    android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Made with Claude -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MADE WITH"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 Claude by Anthropic"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:text="This entire app was built through a conversation with Claude, Anthropic's AI assistant — from architecture and database design to UI layouts and trash handling quirks on Samsung devices." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
