<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_storage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Left: Today -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tv_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="today"
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tv_today_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— GB"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="available"
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <!-- Divider -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/widget_divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Right: Yesterday -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="6dp">

        <TextView
            android:id="@+id/tv_yesterday_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="yesterday"
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tv_yesterday_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— GB"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/tv_yesterday_diff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</LinearLayout>
